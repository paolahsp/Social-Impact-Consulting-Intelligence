{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/diagnosis.schema.json",
  "title": "Diagnosis",
  "type": "object",
  "required": [
    "diagnosis_id",
    "domain",
    "diagnosis_type",
    "statement",
    "finding_ids",
    "hypothesis_ids",
    "evidence_ids",
    "confidence",
    "requires_validation"
  ],
  "additionalProperties": true,
  "properties": {
    "diagnosis_id": {
      "type": "string",
      "pattern": "^DX-"
    },
    "domain": {
      "type": "string"
    },
    "diagnosis_type": {
      "type": "string",
      "enum": [
        "observed_problem",
        "likely_cause",
        "validated_cause",
        "unknown"
      ]
    },
    "statement": {
      "type": "string"
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-"
      }
    },
    "hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HYP-"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_validation": {
      "type": "boolean"
    }
  }
}
