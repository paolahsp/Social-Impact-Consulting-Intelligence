{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/hypothesis.schema.json",
  "title": "Hypothesis",
  "type": "object",
  "required": [
    "hypothesis_id",
    "run_id",
    "domain",
    "evidence_ids",
    "finding_ids",
    "hypothesis",
    "confidence",
    "requires_validation",
    "validation_gap"
  ],
  "additionalProperties": true,
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^HYP-"
    },
    "run_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-"
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-"
      }
    },
    "hypothesis": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_validation": {
      "const": true
    },
    "validation_gap": {
      "type": "string"
    }
  }
}
